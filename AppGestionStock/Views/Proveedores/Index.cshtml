<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Gestión de Proveedores</title>
    <link href="https://cdnjs.cloudflare.com/ajax/libs/bootstrap/5.3.0/css/bootstrap.min.css" rel="stylesheet">
    <link href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css" rel="stylesheet">
    <link rel="stylesheet" href="~/css/proveedores.css" asp-append-version="true" />
</head>
<body>
    <div class="container">
        <div class="page-header">
            <h2 class="page-title">Gestión de Proveedores</h2>
            <a asp-action="ProveedorCreate" class="btn btn-primary">
                <i class="fas fa-plus"></i> Nuevo Proveedor
            </a>
        </div>

        @if (TempData["SuccessMessage"] != null)
        {
            <div class="alert alert-success alert-dismissible fade show" role="alert">
                <i class="fas fa-check-circle me-2"></i>
                @TempData["SuccessMessage"]
                <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
            </div>
        }

        @if (TempData["ErrorMessage"] != null)
        {
            <div class="alert alert-danger alert-dismissible fade show" role="alert">
                <i class="fas fa-exclamation-circle me-2"></i>
                @TempData["ErrorMessage"]
                <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
            </div>
        }

        <div class="card">
            <div class="card-header">
                <div class="search-container">
                    <i class="fas fa-search search-icon"></i>
                    <input type="text" id="searchInput" class="form-control" placeholder="Buscar proveedores por nombre, email o teléfono...">
                </div>
            </div>
            <div class="card-body p-0">
                <div class="table-responsive">
                    <table class="table table-striped table-hover">
                        <thead>
                            <tr>
                                <th>Nombre Empresa</th>
                                <th>Teléfono</th>
                                <th>Email</th>
                                <th>Nombre Contacto</th>
                                <th class="action-column">Acciones</th>
                            </tr>
                        </thead>
                        <tbody id="proveedorTableBody">
                            @if (Model != null)
                            {
                                @foreach (var proveedor in Model)
                                {
                                    <tr>
                                        <td>@proveedor.NombreEmpresa</td>
                                        <td>@proveedor.Telefono</td>
                                        <td>@proveedor.Email</td>
                                        <td>@proveedor.NombreContacto</td>
                                        <td class="action-column">
                                            <a asp-action="ProveedorEdit" asp-route-id="@proveedor.IdProveedor" class="btn btn-warning btn-action">
                                                <i class="fas fa-edit"></i> Editar
                                            </a>
                                            <a asp-action="ProveedorDelete" asp-route-id="@proveedor.IdProveedor" class="btn btn-danger btn-action">
                                                <i class="fas fa-trash"></i> Eliminar
                                            </a>
                                        </td>
                                    </tr>
                                }
                            }
                            else
                            {
                                <tr>
                                    <td colspan="5">
                                        <div class="empty-state">
                                            <i class="fas fa-building"></i>
                                            <p>No hay proveedores registrados.</p>
                                            <a asp-action="ProveedorCreate" class="btn btn-primary">
                                                <i class="fas fa-plus"></i> Agregar proveedor
                                            </a>
                                        </div>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            </div>
        </div>
    </div>

    <script src="https://cdnjs.cloudflare.com/ajax/libs/jquery/3.6.0/jquery.min.js"></script>
    <script src="https://cdnjs.cloudflare.com/ajax/libs/bootstrap/5.3.0/js/bootstrap.bundle.min.js"></script>
    <script>
        $(document).ready(function () {
            // Mejorar la búsqueda para que sea más sensible
            $('#searchInput').on('keyup', function () {
                var value = $(this).val().toLowerCase().trim();
                $('#proveedorTableBody tr').filter(function () {
                    $(this).toggle($(this).text().toLowerCase().indexOf(value) > -1);
                });

                // Mostrar mensaje cuando no hay resultados
                if ($('#proveedorTableBody tr:visible').length === 0) {
                    if ($('#noResultsMessage').length === 0) {
                        $('#proveedorTableBody').append('<tr id="noResultsMessage"><td colspan="5" class="text-center py-4"><i class="fas fa-search me-2"></i>No se encontraron resultados para "' + value + '"</td></tr>');
                    }
                } else {
                    $('#noResultsMessage').remove();
                }
            });

            // Animación para las alertas
            $('.alert').fadeIn().delay(4000).fadeOut('slow');
        });
    </script>
</body>
</html>