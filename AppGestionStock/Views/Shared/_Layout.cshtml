@{
    Usuario? usuario = Context.Session.GetObject<Usuario>("USUARIO");
}

<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - SynchroStock</title>
    <!-- Bootstrap 5 -->
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.2.3/dist/css/bootstrap.min.css" rel="stylesheet">
    <!-- Font Awesome para iconos adicionales -->
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
    <!-- Lucide Icons -->
    <script src="https://unpkg.com/lucide@latest"></script>
    <!-- Google Fonts - Poppins -->
    <link href="https://fonts.googleapis.com/css2?family=Poppins:wght@300;400;500;600;700&display=swap" rel="stylesheet">
    <!-- Estilos personalizados -->
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/estilosLayout.css" asp-append-version="true" />

</head>
<body>
    @if (usuario != null)
    {
        <!-- Top Navigation -->
        <nav class="navbar navbar-expand-lg navbar-light bg-light fixed-top w-100">
            <div class="container-fluid">
                <a class="navbar-brand" href="#">
                    
                        <img src="/images/logo/logo4.png" alt="Logo" class="img-fluid" style="max-height: 50px;">
                    
                </a>

                <!-- Mobile Toggle Button -->
                <button id="sidebarToggleBtn" class="btn btn-link d-lg-none rounded-circle mr-3">
                    <i data-lucide="menu"></i>
                </button>

                <span class="company-name mx-auto d-none d-md-block">@usuario.nombreEmpresa</span>

                <div class="d-flex align-items-center">
                    <!-- Notificaciones -->
                    <div class="dropdown me-3">
                        <a href="#" id="notificaciones-btn" class="btn btn-link notifications-icon position-relative">
                            @if (ViewData["NOTIFICACIONES"] != null && ((List<Notificacion>)ViewData["NOTIFICACIONES"]).Count > 0)
                            {
                                <i data-lucide="bell-dot" style="color: var(--warning-color)"></i>
                                <span class="badge bg-danger rounded-pill notifications-badge">
                                    @(((List<Notificacion>)ViewData["NOTIFICACIONES"]).Count)
                                </span>
                            }
                            else
                            {
                                <i data-lucide="bell"></i>
                            }
                        </a>

                        <div id="notificaciones-dropdown" class="dropdown-menu dropdown-menu-end">
                            <h6 class="dropdown-header">Centro de Notificaciones</h6>

                            @if (ViewData["NOTIFICACIONES"] != null)
                            {
                                List<Notificacion> notificaciones = (List<Notificacion>)ViewData["NOTIFICACIONES"];
                                if (notificaciones.Any())
                                {
                                    foreach (var notificacion in notificaciones)
                                    {
                                        <a class="dropdown-item notificacion-item d-flex align-items-center" href="#">
                                            <div class="me-3">
                                                <div class="icon-circle bg-primary text-white p-2 d-flex align-items-center justify-content-center rounded-circle">
                                                    <i data-lucide="alert-circle" style="width: 16px; height: 16px;"></i>
                                                </div>
                                            </div>
                                            <div>
                                                <div class="small text-muted">@notificacion.Fecha.ToString("dd/MM/yyyy HH:mm")</div>
                                                <span>@notificacion.Mensaje</span>
                                            </div>
                                        </a>
                                    }
                                }
                                else
                                {
                                    <a class="dropdown-item text-center py-3">No hay notificaciones.</a>
                                }
                            }
                            else
                            {
                                <a class="dropdown-item text-center py-3">No hay notificaciones.</a>
                            }

                            <a class="dropdown-item text-center small text-muted py-2" href="#">Mostrar todas</a>
                        </div>
                    </div>

                    <!-- Separador vertical -->
                    <div class="vr mx-3 d-none d-sm-block" style="height: 24px;"></div>

                    <!-- User Dropdown -->
                    <div class="dropdown">
                        <a href="#" class="d-flex align-items-center text-decoration-none dropdown-toggle" id="userDropdown" data-bs-toggle="dropdown" aria-expanded="false">
                            <img src="~/images/usuarios/@usuario.Imagen" alt="Usuario" class="rounded-circle" width="32" height="32" style="object-fit: cover;">
                            <span class="d-none d-sm-inline ms-2">@usuario.Nombre</span>
                        </a>
                        <ul class="dropdown-menu dropdown-menu-end shadow" aria-labelledby="userDropdown">
                            <li><a class="dropdown-item" href="#"><i class="fas fa-user-cog fa-sm fa-fw me-2 text-gray-400"></i> Perfil</a></li>
                            <li><a class="dropdown-item" href="#"><i class="fas fa-cogs fa-sm fa-fw me-2 text-gray-400"></i> Configuración</a></li>
                            <li><hr class="dropdown-divider"></li>
                            <li>
                                <a class="dropdown-item" asp-controller="Usuarios" asp-action="LogOut">
                                    <i class="fas fa-sign-out-alt fa-sm fa-fw me-2 text-gray-400"></i> Cerrar sesión
                                </a>
                            </li>
                        </ul>
                    </div>
                </div>
            </div>
        </nav>

        <!-- Sidebar -->
        <nav class="sidebar" id="sidebar">
            @* <div class="sidebar-header d-none d-lg-block">
                <img src="/images/logo/logo4.png" alt="Logo" class="img-fluid" style="max-height: 50px;">
            </div> *@

            <ul class="nav flex-column">
                <li class="nav-item">
                    <a class="nav-link @(ViewContext.RouteData.Values["Controller"].ToString() == "Home" && ViewContext.RouteData.Values["Action"].ToString() == "Index" ? "active" : "")"
                       asp-controller="Home" asp-action="Index">
                        <i data-lucide="home"></i> <span>Dashboard</span>
                    </a>
                </li>

                <li class="nav-item">
                    <a class="nav-link dropdown-toggle" href="#" data-bs-toggle="collapse" data-bs-target="#productosMenu">
                        <i data-lucide="package"></i> <span>Productos</span>
                    </a>
                    <div class="collapse submenu @(ViewContext.RouteData.Values["Controller"].ToString() == "Productos" ? "show" : "")" id="productosMenu">
                        <a class="nav-link @(ViewContext.RouteData.Values["Action"].ToString() == "ProductosTienda" ? "active" : "")"
                           asp-controller="Productos" asp-action="ProductosTienda">
                            <i data-lucide="store"></i> <span>Ver Productos</span>
                        </a>
                        <a class="nav-link @(ViewContext.RouteData.Values["Action"].ToString() == "CrearProducto" ? "active" : "")"
                           asp-controller="Productos" asp-action="CrearProducto">
                            <i data-lucide="plus-circle"></i> <span>Agregar Producto</span>
                        </a>
                    </div>
                </li>

                <li class="nav-item">
                    <a class="nav-link @(ViewContext.RouteData.Values["Controller"].ToString() == "Clientes" ? "active" : "")"
                       asp-controller="Clientes" asp-action="Clientes">
                        <i data-lucide="users"></i> <span>Clientes</span>
                    </a>
                </li>

                <li class="nav-item">
                    <a class="nav-link @(ViewContext.RouteData.Values["Controller"].ToString() == "Proveedores" ? "active" : "")"
                       asp-controller="Proveedores" asp-action="Index">
                        <i data-lucide="truck"></i> <span>Proveedores</span>
                    </a>
                </li>

                <li class="nav-item">
                    <a class="nav-link dropdown-toggle" href="#" data-bs-toggle="collapse" data-bs-target="#inventarioMenu">
                        <i data-lucide="clipboard"></i> <span>Inventario</span>
                    </a>
                    <div class="collapse submenu @(ViewContext.RouteData.Values["Controller"].ToString() == "Inventario" ? "show" : "")" id="inventarioMenu">
                        <a class="nav-link @(ViewContext.RouteData.Values["Action"].ToString() == "Venta" ? "active" : "")"
                           asp-controller="Inventario" asp-action="Venta">
                            <i data-lucide="trending-down"></i> <span>Registrar Venta</span>
                        </a>
                        <a class="nav-link @(ViewContext.RouteData.Values["Action"].ToString() == "Compra" ? "active" : "")"
                           asp-controller="Inventario" asp-action="Compra">
                            <i data-lucide="trending-up"></i> <span>Registrar Compra</span>
                        </a>
                    </div>
                </li>

                <li class="nav-item">
                    <a class="nav-link dropdown-toggle" href="#" data-bs-toggle="collapse" data-bs-target="#reportesMenu">
                        <i data-lucide="bar-chart"></i> <span>Reportes</span>
                    </a>
                    <div class="collapse submenu @(ViewContext.RouteData.Values["Controller"].ToString() == "Reportes" ? "show" : "")" id="reportesMenu">
                        <a class="nav-link @(ViewContext.RouteData.Values["Action"].ToString() == "Index" ? "active" : "")"
                           asp-controller="Reportes" asp-action="Index">
                            <i data-lucide="file-text"></i> <span>Info. Inventario</span>
                        </a>
                    </div>
                </li>
                <li class="nav-item">
                    <a asp-controller="Factura" asp-action="Subir" class="nav-link">Subir facturas</a>
                </li>
            </ul>
        </nav>
         
        <!-- Right Panel - Movimientos Recientes -->
        <aside class="right-panel">
            <h6><i data-lucide="activity" class="me-2" style="width: 18px; height: 18px;"></i>Movimientos Recientes</h6>

            @if (Context.Session.GetObject<List<VistaInventarioDetalladoVenta>>("INVENTARIO") is List<VistaInventarioDetalladoVenta> inventarioList && inventarioList.Any())
            {
                inventarioList.Reverse();
                foreach (var movimiento in inventarioList.Take(8))
                {
                    <div class="movimientos-card card">
                        <div class="card-body">
                            <p class="card-text">
                                @if (movimiento.TipoMovimiento == "Salida")
                                {
                                    <span><span class="salida">Salida:</span> @movimiento.Cantidad u. de <strong>@movimiento.NombreProducto</strong></span>
                                }
                                else if (movimiento.TipoMovimiento == "Entrada")
                                {
                                    <span><span class="entrada">Entrada:</span> @movimiento.Cantidad u. de <strong>@movimiento.NombreProducto</strong></span>
                                }
                                else
                                {
                                    <span>Stock actualizado: Producto <strong>@movimiento.IdProducto</strong></span>
                                }
                            </p>
                        </div>

                        <button class="toggle-details-button">
                            <i class="toggle-details" data-lucide="chevron-down" style="width: 18px; height: 18px;"></i>
                        </button>

                        <div class="movimiento-detalles d-none">
                            <p><strong>Fecha:</strong> @movimiento.FechaMovimiento.ToString("dd/MM/yyyy HH:mm")</p>
                            <p><strong>Tipo:</strong> @movimiento.TipoMovimiento</p>
                            <p><strong>Cantidad:</strong> @movimiento.Cantidad</p>

                            @if (movimiento.IdCliente.HasValue && !string.IsNullOrEmpty(movimiento.NombreCliente))
                            {
                                <p><strong>Cliente:</strong> @movimiento.NombreCliente</p>
                            }
                            else
                            {
                                <p><strong>Cliente:</strong> No especificado</p>
                            }

                            <p><strong>Tienda:</strong> @(movimiento.NombreTienda ?? "No especificado")</p>
                        </div>
                    </div>
                }
                <div class="text-center mt-3">
                    <a href="#" class="btn btn-sm btn-outline-primary">Ver todos los movimientos</a>
                </div>
            }
            else
            {
                <div class="alert alert-info">
                    <i data-lucide="info" class="me-2" style="width: 18px; height: 18px;"></i>
                    No hay movimientos recientes.
                </div>
            }
        </aside>
    }

    <!-- Main Content -->
    <main class="main-content @(usuario == null ? "fullscreen" : "")">
        @RenderBody()
    </main>

    <!-- Scripts -->
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.2.3/dist/js/bootstrap.bundle.min.js"></script>
    <script src="https://code.jquery.com/jquery-3.6.0.min.js"></script>

    <script>
        // Inicializar íconos de Lucide
        document.addEventListener('DOMContentLoaded', function() {
            lucide.createIcons();

            // Toggle notificaciones dropdown
            const notificacionesBtn = document.getElementById('notificaciones-btn');
            const notificacionesDropdown = document.getElementById('notificaciones-dropdown');

            if (notificacionesBtn && notificacionesDropdown) {
                notificacionesBtn.addEventListener('click', function(event) {
                    event.preventDefault();
                    notificacionesDropdown.classList.toggle('show');
                });

                document.addEventListener('click', function(event) {
                    if (!notificacionesBtn.contains(event.target) && !notificacionesDropdown.contains(event.target)) {
                        notificacionesDropdown.classList.remove('show');
                    }
                });
            }

            // Toggle sidebar en móvil
            const sidebarToggleBtn = document.getElementById('sidebarToggleBtn');
            const sidebar = document.getElementById('sidebar');

            if (sidebarToggleBtn && sidebar) {
                sidebarToggleBtn.addEventListener('click', function() {
                    sidebar.classList.toggle('show');
                });
            }

            // Toggle detalles de movimientos
            document.querySelectorAll(".toggle-details-button").forEach(button => {
                button.addEventListener("click", function() {
                    let card = this.closest(".movimientos-card");
                    let detalles = card.querySelector(".movimiento-detalles");
                    let icon = this.querySelector(".toggle-details");

                    if (detalles.classList.contains("d-none")) {
                        detalles.classList.remove("d-none");
                        icon.setAttribute("data-lucide", "chevron-up");
                    } else {
                        detalles.classList.add("d-none");
                        icon.setAttribute("data-lucide", "chevron-down");
                    }

                    lucide.createIcons();
                });
            });

            // Auto-activar submenús para la ruta actual
            const currentController = '@ViewContext.RouteData.Values["Controller"]';
            const currentAction = '@ViewContext.RouteData.Values["Action"]';

            document.querySelectorAll('.submenu').forEach(submenu => {
                const links = submenu.querySelectorAll('.nav-link');
                links.forEach(link => {
                    if (link.classList.contains('active')) {
                        submenu.classList.add('show');
                    }
                });
            });
        });
    </script>

    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>