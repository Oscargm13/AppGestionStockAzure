@model AppGestionStock.Models.FacturaReconocida

<div class="container mt-4">
    <h2>Información extraída de la factura</h2>

    <div class="card">
        <div class="card-header">
            Datos generales
        </div>
        <div class="card-body">
            <dl class="row">
                <dt class="col-sm-3">Número de Factura:</dt>
                <dd class="col-sm-9">@Model.IdCompra</dd>

                <dt class="col-sm-3">Fecha:</dt>
                <dd class="col-sm-9">@Model.Fecha</dd>

                <dt class="col-sm-3">Proveedor:</dt>
                <dd class="col-sm-9">@Model.Proveedor</dd>

                <dt class="col-sm-3">Cliente:</dt>
                <dd class="col-sm-9">@Model.Cliente</dd>

                <dt class="col-sm-3">Importe Total:</dt>
                <dd class="col-sm-9">@(Model.ImporteTotal?.ToString("C") ?? "No disponible")</dd>
            </dl>
        </div>
    </div>

    <div class="card mt-4">
        <div class="card-header">
            Productos
        </div>
        <div class="card-body">
            @if (Model.Productos != null && Model.Productos.Any())
            {
                <div class="table-responsive">
                    <table class="table table-striped">
                        <thead>
                            <tr>
                                <th>Descripción</th>
                                <th>Cantidad</th>
                                <th>Precio Unitario</th>
                                <th>Total</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var producto in Model.Productos)
                            {
                                <tr>
                                    <td>@producto.Descripcion</td>
                                    <td>@producto.Cantidad</td>
                                    <td>@producto.PrecioUnitario.ToString("C")</td>
                                    <td>@producto.Total.ToString("C")</td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            }
            else
            {
                <p class="text-muted">No se han encontrado productos en la factura</p>
            }
        </div>
    </div>

    <div class="mt-3">
        <a asp-action="Subir" class="btn btn-primary">Volver</a>

        <form asp-action="Procesar" method="post" class="d-inline">
            @Html.HiddenFor(m => m.IdCompra)
            @Html.HiddenFor(m => m.Fecha)
            @Html.HiddenFor(m => m.Proveedor)
            @Html.HiddenFor(m => m.Cliente)
            @Html.HiddenFor(m => m.ImporteTotal)

            @for (int i = 0; i < Model.Productos.Count; i++)
            {
                @Html.Hidden($"Productos[{i}].Descripcion", Model.Productos[i].Descripcion)
                @Html.Hidden($"Productos[{i}].Cantidad", Model.Productos[i].Cantidad)
                @Html.Hidden($"Productos[{i}].PrecioUnitario", Model.Productos[i].PrecioUnitario)
                @Html.Hidden($"Productos[{i}].Total", Model.Productos[i].Total)
            }

            <button type="submit" class="btn btn-warning">Procesar</button>
        </form>
    </div>

</div>